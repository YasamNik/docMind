# DocMind Docker configuration
# Copy this file to .env and fill in the required values.
#   cp docker.env.example .env

# Required. Generate with: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=

# Required. Generate with: openssl rand -hex 48
AUTH_SECRET=

# Port the container exposes. Change if 4000 is taken.
PORT=4000

# Optional: override the URLs if running behind a reverse proxy.
# SERVER_BASE_URL=https://docmind.example.com
# CLIENT_BASE_URL=https://docmind.example.com

# Optional AI seeds. Configure these in the Settings UI after first login.
# OPENROUTER_API_KEY=
