{
  "name": "@docmind/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=src --import tsx --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/lib-storage": "^3.1136.0",
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@hono/node-server": "^1.14.0",
    "@libsql/client": "^0.18.0",
    "@mozilla/readability": "^0.6.0",
    "@valibot/to-json-schema": "^1.8.0",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "google-auth-library": "^11.1.0",
    "hono": "^4.7.0",
    "imapflow": "^2.0.5",
    "jszip": "^3.10.2",
    "linkedom": "^0.18.13",
    "mailparser": "^3.9.28",
    "mammoth": "^1.12.3",
    "openai": "^7.16.0",
    "pdfjs-dist": "^6.3.289",
    "pino": "^9.6.0",
    "tesseract.js": "^7.0.0",
    "undici": "^8.10.2",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.15.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
