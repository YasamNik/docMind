# Required. Generate with: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=

# Required. Generate with: openssl rand -hex 48
AUTH_SECRET=

PORT=4000
SERVER_BASE_URL=http://localhost:4000
CLIENT_BASE_URL=http://localhost:5173
DATABASE_URL=file:./docmind.sqlite
DOCUMENT_STORAGE_ROOT=./documents

# Optional seeds. The settings UI overrides these.
# Read from Milestone C onward. Setting them now has no effect.
OPENROUTER_API_KEY=
AI_RULES_MODEL=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=
DATA_DIR=./data
OCR_LANGUAGES=eng
